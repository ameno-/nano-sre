# Keep
KEEP_X_API_KEY=local-dev
KEEP_LOKI_PROVIDER_ID=

# Model routing (OpenRouter)
OPENROUTER_API_KEY=
NANO_SRE_PROVIDER=openrouter
NANO_SRE_MODEL_ID=google/gemini-3-flash-preview
NANO_SRE_THINKING_LEVEL=off

# Optional service-to-service auth
NANO_SRE_SERVICE_TOKEN=

# Persistent harness storage path
NANO_SRE_STORE_PATH=/tmp/nano-sre-store.json

# Nanobot runtime mode
NANOBOT_ENV=development
